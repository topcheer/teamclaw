{
  "name": "teamclaw-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform TeamClaw desktop client",
  "author": "Junjun Zhang <topcheer@me.com>",
  "homepage": "https://topcheer.github.io/teamclaw/",
  "main": "main.mjs",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:mac:x64": "electron-builder --mac dmg zip --x64",
    "dist:mac:arm64": "electron-builder --mac dmg zip --arm64",
    "dist:mac:universal": "electron-builder --mac dmg zip --universal",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:linux:x64": "electron-builder --linux AppImage deb --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage deb --arm64",
    "dist:win": "electron-builder --win nsis",
    "dist:win:x64": "electron-builder --win nsis --x64",
    "dist:win:arm64": "electron-builder --win nsis --arm64",
    "dist:dir": "electron-builder --dir",
    "smoke": "node --check main.mjs && node --check preload.mjs && node --check renderer/app.js"
  },
  "build": {
    "appId": "gg.ai.teamclaw",
    "productName": "TeamClaw Desktop",
    "files": [
      "main.mjs",
      "preload.mjs",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "notarize": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "devDependencies": {
    "electron": "^36.2.1",
    "electron-builder": "^24.13.3"
  }
}
