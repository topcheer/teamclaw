{
  "name": "teamclaw-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform TeamClaw desktop client",
  "author": "Junjun Zhang <topcheer@me.com>",
  "homepage": "https://topcheer.github.io/teamclaw/",
  "main": "main.mjs",
  "scripts": {
    "dev": "electron .",
    "dist": "npm run prepare-bundled && electron-builder",
    "dist:mac": "npm run prepare-bundled && electron-builder --mac dmg zip",
    "dist:mac:x64": "npm run prepare-bundled && electron-builder --mac dmg zip --x64",
    "dist:mac:arm64": "npm run prepare-bundled && electron-builder --mac dmg zip --arm64",
    "dist:mac:universal": "npm run prepare-bundled && electron-builder --mac dmg zip --universal",
    "dist:linux": "npm run prepare-bundled && electron-builder --linux AppImage deb",
    "dist:linux:x64": "npm run prepare-bundled && electron-builder --linux AppImage deb --x64",
    "dist:linux:arm64": "npm run prepare-bundled && electron-builder --linux AppImage deb --arm64",
    "dist:win": "npm run prepare-bundled && electron-builder --win nsis",
    "dist:win:x64": "npm run prepare-bundled && electron-builder --win nsis --x64",
    "dist:win:arm64": "npm run prepare-bundled && electron-builder --win nsis --arm64",
    "dist:dir": "npm run prepare-bundled && electron-builder --dir",
    "smoke": "node --check main.mjs && node --check preload.mjs && node --check renderer/app.js",
    "prepare-bundled": "node scripts/prepare-bundled.mjs",
    "dist:mas": "electron-builder --mac mas pkg"
  },
  "build": {
    "appId": "dev.ggcode.teamclaw",
    "productName": "TeamClaw Desktop",
    "files": [
      "main.mjs",
      "preload.mjs",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "notarize": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "build/bundle",
        "to": "bin"
      }
    ],
    "mas": {
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.plist",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "provisioningProfile": "build/embedded.provisionprofile",
      "notarize": false
    }
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  }
}
