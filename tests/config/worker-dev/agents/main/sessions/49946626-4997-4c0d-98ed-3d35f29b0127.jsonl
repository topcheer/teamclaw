{"type":"message","id":"bbc72026","parentId":"2958c55f","timestamp":"2026-03-28T03:57:56.770Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_6683c7e588284cfbb21f0de6","name":"write","arguments":{"file_path":"/home/node/.openclaw/workspace/ecommerce/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Shop — Modern E-Commerce</title>\n<style>\n  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\n  :root{\n    --bg:#f8f9fa;--surface:#fff;--text:#1a1a2e;--text-muted:#6b7280;\n    --accent:#4f46e5;--accent-hover:#4338ca;--radius:12px;\n    --shadow-sm:0 1px 3px rgba(0,0,0,.06);--shadow-md:0 4px 20px rgba(0,0,0,.08);\n    --shadow-lg:0 8px 30px rgba(0,0,0,.12);--transition:.25s ease;\n  }\n  body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--text);line-height:1.5}\n\n  /* Header */\n  header{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.85);backdrop-filter:blur(12px);border-bottom:1px solid #e5e7eb;padding:0 24px}\n  .header-inner{max-width:1280px;margin:0 auto;display:flex;align-items:center;gap:20px;height:64px}\n  .logo{font-size:1.35rem;font-weight:700;letter-spacing:-.5px;color:var(--accent);white-space:nowrap}\n  .search-box{flex:1;max-width:480px;position:relative}\n  .search-box input{width:100%;padding:10px 16px 10px 42px;border:1.5px solid #e5e7eb;border-radius:99px;font-size:.9rem;background:var(--bg);transition:var(--transition);outline:none}\n  .search-box input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(79,70,229,.12)}\n  .search-box svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);pointer-events:none}\n  .header-actions{display:flex;align-items:center;gap:16px}\n  .cart-btn{position:relative;background:none;border:none;cursor:pointer;color:var(--text);padding:8px}\n  .cart-badge{position:absolute;top:0;right:0;background:var(--accent);color:#fff;font-size:.65rem;font-weight:700;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center}\n\n  /* Categories */\n  .categories{max-width:1280px;margin:24px auto 0;padding:0 24px;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}\n  .categories::-webkit-scrollbar{display:none}\n  .cat-btn{padding:8px 18px;border-radius:99px;border:1.5px solid #e5e7eb;background:var(--surface);font-size:.85rem;font-weight:500;cursor:pointer;white-space:nowrap;transition:var(--transition);color:var(--text-muted)}\n  .cat-btn:hover{border-color:var(--accent);color:var(--accent)}\n  .cat-btn.active{background:var(--accent);color:#fff;border-color:var(--accent)}\n\n  /* Grid */\n  .product-grid{max-width:1280px;margin:24px auto 60px;padding:0 24px;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px}\n\n  /* Card */\n  .card{background:var(--surface);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);transition:transform var(--transition),box-shadow var(--transition);cursor:pointer}\n  .card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}\n  .card-img{position:relative;aspect-ratio:1;background:#eef0f4;overflow:hidden}\n  .card-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease}\n  .card:hover .card-img img{transform:scale(1.06)}\n  .card-body{padding:16px}\n  .card-category{font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--accent);margin-bottom:4px}\n  .card-title{font-size:.95rem;font-weight:600;margin-bottom:6px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n  .card-price{font-size:1.1rem;font-weight:700;color:var(--text);margin-bottom:12px}\n  .card-price .original{text-decoration:line-through;color:var(--text-muted);font-weight:400;font-size:.85rem;margin-left:6px}\n  .add-btn{width:100%;padding:10px;border:none;border-radius:8px;background:var(--accent);color:#fff;font-size:.85rem;font-weight:600;cursor:pointer;transition:var(--transition);display:flex;align-items:center;justify-content:center;gap:6px}\n  .add-btn:hover{background:var(--accent-hover)}\n  .add-btn:active{transform:scale(.97)}\n  .add-btn.added{background:#10b981}\n\n  /* Toast */\n  .toast-container{position:fixed;bottom:24px;right:24px;z-index:200;display:flex;flex-direction:column;gap:8px}\n  .toast{background:var(--text);color:#fff;padding:12px 20px;border-radius:8px;font-size:.85rem;font-weight:500;animation:slideIn .3s ease,fadeOut .3s ease 1.7s forwards;box-shadow:var(--shadow-lg)}\n  @keyframes slideIn{from{transform:translateX(40px);opacity:0}to{transform:none;opacity:1}}\n  @keyframes fadeOut{to{opacity:0;transform:translateY(8px)}}\n\n  @media(max-width:640px){\n    .header-inner{gap:12px}\n    .logo{font-size:1.1rem}\n    .search-box{max-width:none}\n    .product-grid{grid-template-columns:repeat(2,1fr);gap:12px}\n    .card-body{padding:12px}\n  }\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"header-inner\">\n    <div class=\"logo\">✦ shop</div>\n    <div class=\"search-box\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/></svg>\n      <input type=\"text\" id=\"searchInput\" placeholder=\"Search products...\">\n    </div>\n    <div class=\"header-actions\">\n      <button class=\"cart-btn\" aria-label=\"Cart\" onclick=\"showToast('Cart coming soon!')\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"21\" r=\"1\"/><circle cx=\"20\" cy=\"21\" r=\"1\"/><path d=\"M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6\"/></svg>\n        <span class=\"cart-badge\" id=\"cartBadge\">0</span>\n      </button>\n    </div>\n  </div>\n</header>\n\n<nav class=\"categories\" id=\"categories\">\n  <button class=\"cat-btn active\" data-cat=\"all\">All</button>\n  <button class=\"cat-btn\" data-cat=\"electronics\">Electronics</button>\n  <button class=\"cat-btn\" data-cat=\"clothing\">Clothing</button>\n  <button class=\"cat-btn\" data-cat=\"accessories\">Accessories</button>\n  <button class=\"cat-btn\" data-cat=\"home\">Home</button>\n  <button class=\"cat-btn\" data-cat=\"sports\">Sports</button>\n</nav>\n\n<main class=\"product-grid\" id=\"productGrid\"></main>\n<div class=\"toast-container\" id=\"toastContainer\"></div>\n\n<script>\nconst products = [\n  { id:1, name:\"Wireless Noise-Cancelling Headphones\", category:\"electronics\", price:89.99, originalPrice:129.99, img:\"https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&h=600&fit=crop\" },\n  { id:2, name:\"Minimalist Leather Backpack\", category:\"accessories\", price:64.99, img:\"https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600&h=600&fit=crop\" },\n  { id:3, name:\"Organic Cotton Crew Neck Tee\", category:\"clothing\", price:34.99, originalPrice:49.99, img:\"https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=600&h=600&fit=crop\" },\n  { id:4, name:\"Smart Fitness Watch\", category:\"electronics\", price:199.99, originalPrice:249.99, img:\"https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&h=600&fit=crop\" },\n  { id:5, name:\"Ceramic Pour-Over Coffee Set\", category:\"home\", price:42.99, img:\"https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600&h=600&fit=crop\" },\n  { id:6, name:\"Running Performance Sneakers\", category:\"sports\", price:119.99, originalPrice:159.99, img:\"https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600&h=600&fit=crop\" },\n  { id:7, name:\"Linen Relaxed Fit Shirt\", category:\"clothing\", price:54.99, img:\"https://images.unsplash.com/photo-1596755094514-f87e34085b2c?w=600&h=600&fit=crop\" },\n  { id:8, name:\"Handblown Glass Vase\", category:\"home\", price:38.99, img:\"https://images.unsplash.com/photo-1581783898377-1c85bf937427?w=600&h=600&fit=crop\" },\n  { id:9, name:\"Titanium Aviator Sunglasses\", category:\"accessories\", price:78.99, originalPrice:99.99, img:\"https://images.unsplash.com/photo-1572635196237-14b3f281503f?w=600&h=600&fit=crop\" },\n  { id:10, name:\"Portable Bluetooth Speaker\", category:\"electronics\", price:49.99, img:\"https://images.unsplash.com/photo-1608043152269-423dbba4e7e1?w=600&h=600&fit=crop\" },\n  { id:11, name:\"Yoga Mat — Natural Rubber\", category:\"sports\", price:59.99, img:\"https://images.unsplash.com/photo-1601925260368-ae2f83cf8b7f?w=600&h=600&fit=crop\" },\n  { id:12, name:\"Canvas Weekender Duffle Bag\", category:\"accessories\", price:84.99, originalPrice:109.99, img:\"https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600&h=600&fit=crop\" },\n];\n\nlet cartCount = 0;\nconst grid = document.getElementById('productGrid');\nconst searchInput = document.getElementById('searchInput');\nconst categoriesNav = document.getElementById('categories');\nconst cartBadge = document.getElementById('cartBadge');\nconst toastContainer = document.getElementById('toastContainer');\n\nlet activeCategory = 'all';\n\nfunction renderProducts(items) {\n  if (items.length === 0) {\n    grid.innerHTML = '<p style=\"grid-column:1/-1;text-align:center;color:var(--text-muted);padding:60px 0\">No products found.</p>';\n    return;\n  }\n  grid.innerHTML = items.map(p => `\n    <article class=\"card\" data-id=\"${p.id}\">\n      <div class=\"card-img\">\n        <img src=\"${p.img}\" alt=\"${p.name}\" loading=\"lazy\">\n      </div>\n      <div class=\"card-body\">\n        <div class=\"card-category\">${p.category}</div>\n        <h3 class=\"card-title\">${p.name}</h3>\n        <div class=\"card-price\">$${p.price.toFixed(2)}${p.originalPrice ? `<span class=\"original\">$${p.originalPrice.toFixed(2)}</span>` : ''}</div>\n        <button class=\"add-btn\" onclick=\"addToCart(event, ${p.id})\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/></svg>\n          Add to Cart\n        </button>\n      </div>\n    </article>\n  `).join('');\n}\n\nfunction getFilteredProducts() {\n  const q = searchInput.value.toLowerCase().trim();\n  return products.filter(p => {\n    const matchCat = activeCategory === 'all' || p.category === activeCategory;\n    const matchSearch = !q || p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q);\n    return matchCat && matchSearch;\n  });\n}\n\nfunction addToCart(e, id) {\n  e.stopPropagation();\n  const btn = e.currentTarget;\n  btn.classList.add('added');\n  btn.innerHTML = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg> Added';\n  cartCount++;\n  cartBadge.textContent = cartCount;\n  const product = products.find(p => p.id === id);\n  showToast(`${product.name} added to cart`);\n  setTimeout(() => {\n    btn.classList.remove('added');\n    btn.innerHTML = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/></svg> Add to Cart';\n  }, 1200);\n}\n\nfunction showToast(msg) {\n  const el = document.createElement('div');\n  el.className = 'toast';\n  el.textContent = msg;\n  toastContainer.appendChild(el);\n  setTimeout(() => el.remove(), 2000);\n}\n\ncategoriesNav.addEventListener('click', e => {\n  if (!e.target.classList.contains('cat-btn')) return;\n  categoriesNav.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));\n  e.target.classList.add('active');\n  activeCategory = e.target.dataset.cat;\n  renderProducts(getFilteredProducts());\n});\n\nsearchInput.addEventListener('input', () => renderProducts(getFilteredProducts()));\n\nrenderProducts(products);\n</script>\n</body>\n</html>\n"}}],"api":"openai-completions","provider":"zai","model":"glm-5-turbo","usage":{"input":47,"output":3592,"cacheRead":13418,"cacheWrite":0,"totalTokens":17057,"cost":{"input":0.000056399999999999995,"output":0.014367999999999999,"cacheRead":0.0032203199999999996,"cacheWrite":0,"total":0.01764472}},"stopReason":"toolUse","timestamp":1774670185765,"responseId":"202603281156262fddd1553b55436b"}}
