{"type":"message","id":"4935ab62","parentId":"650716dc","timestamp":"2026-03-28T04:20:56.396Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_5acdf1cc34b8402b963900cf","name":"write","arguments":{"path":"/home/node/.openclaw/workspace/rss-reader/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>RSS Reader</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },\n        }\n      }\n    }\n  </script>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n    .feed-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }\n    .article-card { transition: all 0.2s ease; }\n    .article-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,0.1); }\n    .article-card.read { opacity: 0.6; }\n    .sidebar-item { transition: background 0.15s; }\n    .sidebar-item:hover { background: rgba(255,255,255,0.08); }\n    .sidebar-item.active { background: rgba(255,255,255,0.12); }\n    ::-webkit-scrollbar { width: 6px; }\n    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }\n  </style>\n</head>\n<body class=\"bg-gray-50 font-sans text-gray-900 h-screen flex flex-col overflow-hidden\">\n\n  <!-- Top bar -->\n  <header class=\"bg-white border-b border-gray-200 px-6 py-3 flex items-center justify-between flex-shrink-0\">\n    <div class=\"flex items-center gap-3\">\n      <svg class=\"w-7 h-7 text-orange-500\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n        <path d=\"M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16\"/><circle cx=\"5\" cy=\"19\" r=\"1\"/>\n      </svg>\n      <h1 class=\"text-xl font-bold tracking-tight\">RSS Reader</h1>\n    </div>\n    <div class=\"flex items-center gap-3\">\n      <div class=\"relative\">\n        <input id=\"searchInput\" type=\"text\" placeholder=\"Search articles…\"\n          class=\"pl-9 pr-4 py-2 w-64 bg-gray-100 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent\">\n        <svg class=\"w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n          <circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.35-4.35\"/>\n        </svg>\n      </div>\n      <button onclick=\"openAddFeedModal()\" class=\"bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2\">\n        <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14m-7-7h14\"/></svg>\n        Add Feed\n      </button>\n    </div>\n  </header>\n\n  <div class=\"flex flex-1 overflow-hidden\">\n    <!-- Sidebar -->\n    <aside class=\"w-64 bg-gray-900 text-white flex-shrink-0 flex flex-col overflow-y-auto\">\n      <nav class=\"p-3 flex-1\">\n        <div id=\"sidebarItems\"></div>\n      </nav>\n      <div class=\"p-3 border-t border-gray-700\">\n        <button onclick=\"markAllRead()\" class=\"w-full text-left text-sm text-gray-400 hover:text-white py-2 px-3 rounded-lg hover:bg-gray-800 transition-colors\">\n          ✓ Mark all as read\n        </button>\n      </div>\n    </aside>\n\n    <!-- Main content -->\n    <main class=\"flex-1 overflow-y-auto p-6\" id=\"mainContent\">\n      <div id=\"articleList\" class=\"max-w-3xl mx-auto\"></div>\n    </main>\n  </div>\n\n  <!-- Add Feed Modal -->\n  <div id=\"addFeedModal\" class=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden\">\n    <div class=\"bg-white rounded-2xl shadow-2xl w-full max-w-md p-6\">\n      <h2 class=\"text-lg font-bold mb-4\">Add RSS Feed</h2>\n      <div class=\"space-y-3\">\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Feed Name</label>\n          <input id=\"feedNameInput\" type=\"text\" placeholder=\"e.g. My Blog\" class=\"w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-orange-400\">\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Feed URL</label>\n          <input id=\"feedUrlInput\" type=\"text\" placeholder=\"https://example.com/feed.xml\" class=\"w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-orange-400\">\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Color</label>\n          <div id=\"colorPicker\" class=\"flex gap-2\"></div>\n        </div>\n      </div>\n      <div class=\"flex justify-end gap-2 mt-5\">\n        <button onclick=\"closeAddFeedModal()\" class=\"px-4 py-2 text-sm text-gray-600 hover:text-gray-800\">Cancel</button>\n        <button onclick=\"addFeed()\" class=\"px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg text-sm font-medium\">Add Feed</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Article Detail Modal -->\n  <div id=\"articleModal\" class=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden\">\n    <div class=\"bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[80vh] overflow-y-auto p-8 relative\">\n      <button onclick=\"closeArticleModal()\" class=\"absolute top-4 right-4 text-gray-400 hover:text-gray-600\">\n        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg>\n      </button>\n      <div id=\"articleDetail\"></div>\n    </div>\n  </div>\n\n<script>\nconst COLORS = ['#ef4444','#f97316','#eab308','#22c55e','#06b6d4','#3b82f6','#8b5cf6','#ec4899'];\n\nconst MOCK_FEEDS = [\n  { id: 'f1', name: 'Hacker News', url: 'https://news.ycombinator.com/rss', color: '#f97316' },\n  { id: 'f2', name: 'TechCrunch', url: 'https://techcrunch.com/feed/', color: '#06b6d4' },\n  { id: 'f3', name: 'The Verge', url: 'https://www.theverge.com/rss/index.xml', color: '#8b5cf6' },\n  { id: 'f4', name: 'Ars Technica', url: 'https://feeds.arstechnica.com/arstechnica/index', color: '#ef4444' },\n  { id: 'f5', name: 'Smashing Magazine', url: 'https://www.smashingmagazine.com/feed/', color: '#eab308' },\n];\n\nconst MOCK_ARTICLES = [\n  { id:'a1', feedId:'f1', title:'Show HN: I built a real-time collaborative code editor in the browser', summary:'A developer shares their experience building a collaborative code editor using CRDTs and WebRTC. No server required — peers connect directly.', date:'2026-03-28T08:00:00Z', read:false, author:'pg' },\n  { id:'a2', feedId:'f1', title:'Why SQLite is the most deployed database engine in the world', summary:'An analysis of how SQLite ended up on billions of devices, from smartphones to browsers to embedded systems, and what makes it so reliable.', date:'2026-03-28T06:30:00Z', read:false, author:'dang' },\n  { id:'a3', feedId:'f1', title:'PostgreSQL 18 released with major performance improvements', summary:'The latest version of PostgreSQL includes parallel query improvements, better JSON path support, and significant I/O optimization for large datasets.', date:'2026-03-27T22:00:00Z', read:false, author:'pg' },\n  { id:'a4', feedId:'f2', title:'OpenAI raises $50B in new funding round at $500B valuation', summary:'The AI giant has closed its largest funding round to date, with participation from major tech companies and sovereign wealth funds.', date:'2026-03-28T10:00:00Z', read:false, author:'TechCrunch' },\n  { id:'a5', feedId:'f2', title:'Stripe launches instant bank payouts in 30 new countries', summary:'Stripe expands its instant payout capabilities, allowing businesses in 30 additional countries to access funds within minutes.', date:'2026-03-28T07:15:00Z', read:false, author:'TechCrunch' },\n  { id:'a6', feedId:'f3', title:'The best laptops of 2026: our top picks reviewed', summary:'From ultrabooks to gaming powerhouses, we tested over 50 laptops to find the absolute best options for every budget and use case.', date:'2026-03-28T09:00:00Z', read:false, author:'The Verge' },\n  { id:'a7', feedId:'f3', title:'Apple Vision Pro 2 leaks suggest lighter design and lower price', summary:'Supply chain sources indicate the next Vision headset will be 40% lighter and cost significantly less than the original $3,499 model.', date:'2026-03-27T18:00:00Z', read:true, author:'The Verge' },\n  { id:'a8', feedId:'f4', title:'Scientists achieve room-temperature superconductivity at ambient pressure', summary:'A team of researchers has published peer-reviewed results demonstrating superconductivity at room temperature and standard atmospheric pressure.', date:'2026-03-28T11:00:00Z', read:false, author:'Ars Technica' },\n  { id:'a9', feedId:'f4', title:'Linux kernel 7.0 arrives with improved hardware support', summary:'The latest kernel release brings better ARM64 support, new filesystem features, and significant improvements to the Btrfs and XFS filesystems.', date:'2026-03-28T05:00:00Z', read:false, author:'Ars Technica' },\n  { id:'a10', feedId:'f5', title:'A Complete Guide to CSS Container Queries in 2026', summary:'Container queries are now supported everywhere. This comprehensive guide covers every aspect, from basic syntax to advanced responsive patterns.', date:'2026-03-27T14:00:00Z', read:true, author:'Smashing' },\n  { id:'a11', feedId:'f5', title:'Designing for Accessibility: Beyond WCAG Compliance', summary:'True accessibility goes beyond checklists. Learn how to design interfaces that are genuinely usable for everyone, regardless of ability.', date:'2026-03-26T10:00:00Z', read:true, author:'Smashing' },\n  { id:'a12', feedId:'f2', title:'Y Combinator W26 demo day highlights: top 10 startups', summary:'From AI-powered drug discovery to sustainable materials, here are the most promising startups from the latest YC batch.', date:'2026-03-26T16:00:00Z', read:false, author:'TechCrunch' },\n  { id:'a13', feedId:'f3', title:'Google Gemini 3.0 benchmarks show it catching up to GPT-6', summary:'New benchmark results suggest Google\\'s latest AI model is narrowing the gap with OpenAI\\'s frontier model across most evaluation categories.', date:'2026-03-26T12:00:00Z', read:false, author:'The Verge' },\n  { id:'a14', feedId:'f4', title:'The engineering behind Figma\\'s new real-time multiplayer engine', summary:'A deep dive into how Figma rebuilt their collaboration engine to support thousands of concurrent editors with sub-50ms latency.', date:'2026-03-25T20:00:00Z', read:true, author:'Ars Technica' },\n  { id:'a15', feedId:'f1', title:'Ask HN: What are you working on this weekend?', summary:'The weekly thread where hackers share their side projects, learning goals, and weekend coding adventures.', date:'2026-03-28T04:00:00Z', read:false, author:'dang' },\n];\n\nlet feeds = JSON.parse(localStorage.getItem('rss-feeds')) || [...MOCK_FEEDS];\nlet articles = JSON.parse(localStorage.getItem('rss-articles')) || [...MOCK_ARTICLES];\nlet activeFilter = 'all'; // 'all' or feed id\nlet selectedColor = COLORS[0];\n\nfunction save() {\n  localStorage.setItem('rss-feeds', JSON.stringify(feeds));\n  localStorage.setItem('rss-articles', JSON.stringify(articles));\n}\n\nfunction getFeed(id) { return feeds.find(f => f.id === id); }\n\nfunction formatDate(iso) {\n  const d = new Date(iso);\n  const now = new Date();\n  const diff = now - d;\n  if (diff < 3600000) return `${Math.max(1,Math.floor(diff/60000))}m ago`;\n  if (diff < 86400000) return `${Math.floor(diff/3600000)}h ago`;\n  if (diff < 172800000) return 'Yesterday';\n  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });\n}\n\nfunction getUnreadCount(feedId) {\n  if (feedId === 'all') return articles.filter(a => !a.read).length;\n  return articles.filter(a => a.feedId === feedId && !a.read).length;\n}\n\nfunction renderSidebar() {\n  const el = document.getElementById('sidebarItems');\n  const unreadAll = getUnreadCount('all');\n\n  let html = `\n    <button onclick=\"setFilter('all')\" class=\"sidebar-item ${activeFilter==='all'?'active':''} w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm\">\n      <span class=\"flex items-center gap-2.5\">\n        <svg class=\"w-4 h-4 text-orange-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2\"/></svg>\n        All Articles\n      </span>\n      ${unreadAll ? `<span class=\"bg-orange-500 text-white text-xs font-bold px-2 py-0.5 rounded-full\">${unreadAll}</span>` : ''}\n    </button>\n    <div class=\"mt-2 mb-1 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider\">Feeds</div>\n  `;\n\n  feeds.forEach(feed => {\n    const count = getUnreadCount(feed.id);\n    html += `\n      <div class=\"flex items-center group\">\n        <button onclick=\"setFilter('${feed.id}')\" class=\"sidebar-item ${activeFilter===feed.id?'active':''} flex-1 flex items-center justify-between px-3 py-2.5 rounded-lg text-sm\">\n          <span class=\"flex items-center gap-2.5\">\n            <span class=\"feed-dot\" style=\"background:${feed.color}\"></span>\n            ${feed.name}\n          </span>\n          ${count ? `<span class=\"text-xs font-bold text-gray-400\">${count}</span>` : ''}\n        </button>\n        <button onclick=\"removeFeed('${feed.id}')\" class=\"opacity-0 group-hover:opacity-100 text-gray-500 hover:text-red-400 p-1 mr-1 transition-opacity\" title=\"Remove feed\">\n          <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg>\n        </button>\n      </div>\n    `;\n  });\n\n  el.innerHTML = html;\n}\n\nfunction renderArticles() {\n  const el = document.getElementById('articleList');\n  const search = document.getElementById('searchInput').value.toLowerCase();\n\n  let filtered = articles.filter(a => {\n    if (activeFilter !== 'all' && a.feedId !== activeFilter) return false;\n    if (search && !a.title.toLowerCase().includes(search) && !a.summary.toLowerCase().includes(search)) return false;\n    return true;\n  });\n\n  filtered.sort((a, b) => new Date(b.date) - new Date(a.date));\n\n  if (!filtered.length) {\n    el.innerHTML = `<div class=\"text-center text-gray-400 mt-20\"><p class=\"text-lg\">No articles found</p><p class=\"text-sm mt-1\">Try a different filter or search term</p></div>`;\n    return;\n  }\n\n  let html = '';\n  let lastDate = '';\n\n  filtered.forEach(article => {\n    const feed = getFeed(article.feedId);\n    const dateStr = new Date(article.date).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });\n    if (dateStr !== lastDate) {\n      html += `<div class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mt-6 mb-3\">${dateStr}</div>`;\n      lastDate = dateStr;\n    }\n\n    html += `\n      <div class=\"article-card ${article.read ? 'read' : ''} bg-white rounded-xl border border-gray-200 p-5 mb-3 cursor-pointer\" onclick=\"openArticle('${article.id}')\">\n        <div class=\"flex items-start justify-between gap-4\">\n          <div class=\"flex-1 min-w-0\">\n            <div class=\"flex items-center gap-2 mb-1.5\">\n              <span class=\"feed-dot\" style=\"background:${feed?.color||'#999'}\"></span>\n              <span class=\"text-xs font-medium text-gray-500\">${feed?.name||'Unknown'}</span>\n              <span class=\"text-xs text-gray-300\">·</span>\n              <span class=\"text-xs text-gray-400\">${formatDate(article.date)}</span>\n              ${!article.read ? '<span class=\"w-2 h-2 rounded-full bg-orange-400 ml-1\"></span>' : ''}\n            </div>\n            <h3 class=\"font-semibold text-gray-900 mb-1.5 leading-snug ${article.read ? '' : ''}\">${article.title}</h3>\n            <p class=\"text-sm text-gray-500 leading-relaxed line-clamp-2\">${article.summary}</p>\n          </div>\n          <button onclick=\"event.stopPropagation(); toggleRead('${article.id}')\" class=\"flex-shrink-0 mt-1 text-gray-300 hover:text-orange-500 transition-colors\" title=\"${article.read ? 'Mark unread' : 'Mark read'}\">\n            ${article.read\n              ? '<svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z\"/></svg>'\n              : '<svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>'}\n          </button>\n        </div>\n      </div>\n    `;\n  });\n\n  el.innerHTML = html;\n}\n\nfunction setFilter(filter) {\n  activeFilter = filter;\n  renderSidebar();\n  renderArticles();\n}\n\nfunction toggleRead(id) {\n  const a = articles.find(x => x.id === id);\n  if (a) { a.read = !a.read; save(); renderSidebar(); renderArticles(); }\n}\n\nfunction markAllRead() {\n  let filtered = activeFilter === 'all' ? articles : articles.filter(a => a.feedId === activeFilter);\n  filtered.forEach(a => a.read = true);\n  save(); renderSidebar(); renderArticles();\n}\n\nfunction openArticle(id) {\n  const a = articles.find(x => x.id === id);\n  if (!a) return;\n  a.read = true;\n  save();\n  const feed = getFeed(a.feedId);\n\n  document.getElementById('articleDetail').innerHTML = `\n    <div class=\"flex items-center gap-2 mb-4\">\n      <span class=\"feed-dot\" style=\"background:${feed?.color||'#999'}\"></span>\n      <span class=\"text-sm font-medium text-gray-500\">${feed?.name||'Unknown'}</span>\n      <span class=\"text-sm text-gray-300\">·</span>\n      <span class=\"text-sm text-gray-400\">${formatDate(a.date)}</span>\n      ${a.author ? `<span class=\"text-sm text-gray-300\">·</span><span class=\"text-sm text-gray-400\">${a.author}</span>` : ''}\n    </div>\n    <h2 class=\"text-2xl font-bold mb-4 leading-tight\">${a.title}</h2>\n    <div class=\"prose prose-gray max-w-none\">\n      <p class=\"text-gray-600 leading-relaxed\">${a.summary}</p>\n      <p class=\"text-gray-600 leading-relaxed mt-4\">This is a mock article preview. In a production RSS reader, the full article content would be fetched and displayed here, along with any images, embedded media, and formatted HTML content from the original feed.</p>\n      <p class=\"text-gray-600 leading-relaxed mt-4\">The reader supports adding custom feeds via RSS or Atom URLs, marking articles as read or unread, searching across all articles, and filtering by individual feed sources. All state is persisted in localStorage.</p>\n    </div>\n    <div class=\"mt-6 flex gap-2\">\n      <button onclick=\"toggleRead('${a.id}'); closeArticleModal();\" class=\"px-4 py-2 text-sm border border-gray-200 rounded-lg hover:bg-gray-50\">\n        ${a.read ? 'Mark as unread' : 'Mark as read'}\n      </button>\n    </div>\n  `;\n  document.getElementById('articleModal').classList.remove('hidden');\n  renderSidebar();\n  renderArticles();\n}\n\nfunction closeArticleModal() {\n  document.getElementById('articleModal').classList.add('hidden');\n}\n\nfunction openAddFeedModal() {\n  document.getElementById('feedNameInput').value = '';\n  document.getElementById('feedUrlInput').value = '';\n  selectedColor = COLORS[Math.floor(Math.random() * COLORS.length)];\n  renderColorPicker();\n  document.getElementById('addFeedModal').classList.remove('hidden');\n}\n\nfunction closeAddFeedModal() {\n  document.getElementById('addFeedModal').classList.add('hidden');\n}\n\nfunction renderColorPicker() {\n  document.getElementById('colorPicker').innerHTML = COLORS.map(c =>\n    `<button onclick=\"selectColor('${c}')\" class=\"w-7 h-7 rounded-full border-2 transition-transform ${selectedColor===c ? 'border-gray-900 scale-110' : 'border-transparent'}\" style=\"background:${c}\"></button>`\n  ).join('');\n}\n\nfunction selectColor(c) { selectedColor = c; renderColorPicker(); }\n\nfunction addFeed() {\n  const name = document.getElementById('feedNameInput').value.trim();\n  const url = document.getElementById('feedUrlInput').value.trim();\n  if (!name || !url) return;\n\n  const feed = { id: 'f' + Date.now(), name, url, color: selectedColor };\n  feeds.push(feed);\n\n  // Add mock articles for the new feed\n  const titles = [\n    `${name} launches new feature update`,\n    `Behind the scenes at ${name}`,\n    `Top stories from ${name} this week`,\n  ];\n  titles.forEach((title, i) => {\n    articles.push({\n      id: 'a' + Date.now() + i,\n      feedId: feed.id,\n      title,\n      summary: `A sample article from ${name}. In a real app, this content would be fetched from the RSS feed at ${url}.`,\n      date: new Date(Date.now() - i * 3600000 * (i + 2)).toISOString(),\n      read: false,\n      author: name,\n    });\n  });\n\n  save();\n  closeAddFeedModal();\n  renderSidebar();\n  renderArticles();\n}\n\nfunction removeFeed(id) {\n  feeds = feeds.filter(f => f.id !== id);\n  articles = articles.filter(a => a.feedId !== id);\n  if (activeFilter === id) activeFilter = 'all';\n  save(); renderSidebar(); renderArticles();\n}\n\n// Search\ndocument.getElementById('searchInput').addEventListener('input', renderArticles);\n\n// Close modals on backdrop click\ndocument.getElementById('addFeedModal').addEventListener('click', e => { if (e.target === e.currentTarget) closeAddFeedModal(); });\ndocument.getElementById('articleModal').addEventListener('click', e => { if (e.target === e.currentTarget) closeArticleModal(); });\n\n// Escape key\ndocument.addEventListener('keydown', e => {\n  if (e.key === 'Escape') { closeAddFeedModal(); closeArticleModal(); }\n});\n\n//