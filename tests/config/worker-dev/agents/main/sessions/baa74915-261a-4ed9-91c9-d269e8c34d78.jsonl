ont-size:12px;color:var(--text-dim);margin-bottom:6px\">${esc(resp.description || 'Response ' + code)}</div>\n        <div class=\"code-block\">${esc(JSON.stringify(ex, null, 2))}</div>\n      </div>`;\n    });\n    html += '</div>';\n  }\n\n  html += '</div></div>';\n  return html;\n}\n\nfunction renderParamsTable(title, params) {\n  let html = `<h4 style=\"font-size:13px;margin:16px 0 8px\">${title}</h4><table class=\"params-table\"><tr><th>Name</th><th>Type</th><th>In</th><th>Required</th><th>Description</th></tr>`;\n  params.forEach(p => {\n    html += `<tr><td class=\"name\">${esc(p.name)}</td><td class=\"type\">${esc(p.schema?.type || p.type || '')}${p.schema?.format ? ' ('+esc(p.schema.format)+')' : ''}</td><td>${esc(p.in)}</td><td>${p.required ? '<span class=\"required-mark\">required</span>' : ''}</td><td class=\"desc\">${esc(p.description || '')}</td></tr>`;\n  });\n  html += '</table>';\n  return html;\n}\n\n// === Send request ===\nasync function sendRequest(btn) {\n  const method = btn.dataset.method;\n  const pathTemplate = btn.dataset.path;\n  const id = btn.dataset.id;\n  const endpoint = btn.closest('.endpoint-body');\n  \n  // Build URL\n  let resolvedPath = pathTemplate;\n  const authHeaders = getAuthHeaders();\n  const headers = { ...authHeaders, 'Accept': 'application/json', 'Content-Type': 'application/json' };\n\n  // Collect param values\n  endpoint.querySelectorAll('.param-row input').forEach(input => {\n    const name = input.dataset.name;\n    const loc = input.dataset.in;\n    const val = input.value;\n    if(loc === 'path') {\n      resolvedPath = resolvedPath.replace(`{${name}}`, encodeURIComponent(val));\n    }\n  });\n\n  const baseUrl = getBaseUrl();\n  let url = baseUrl + resolvedPath;\n\n  // Query params\n  const qp = [];\n  endpoint.querySelectorAll('.param-row input').forEach(input => {\n    if(input.dataset.in === 'query' && input.value) {\n      qp.push(encodeURIComponent(input.dataset.name) + '=' + encodeURIComponent(input.value));\n    }\n  });\n  if(qp.length) url += '?' + qp.join('&');\n\n  // Update displayed URL\n  document.getElementById('url-' + id).textContent = url;\n\n  // Body\n  let body = undefined;\n  const bodyEl = document.getElementById('body-' + id);\n  if(bodyEl && bodyEl.value.trim()) body = bodyEl.value.trim();\n\n  // Show loading\n  btn.textContent = 'Sending...';\n  btn.disabled = true;\n  const respDiv = document.getElementById('response-' + id);\n  respDiv.style.display = 'block';\n  document.getElementById('status-' + id).textContent = '...';\n  document.getElementById('time-' + id).textContent = '';\n  document.getElementById('respbody-' + id).textContent = '';\n\n  const start = performance.now();\n  try {\n    const opts = { method: method.toUpperCase(), headers };\n    if(body && method !== 'get' && method !== 'head') opts.body = body;\n    const resp = await fetch(url, opts);\n    const elapsed = Math.round(performance.now() - start);\n    const text = await resp.text();\n    \n    document.getElementById('status-' + id).textContent = resp.status + ' ' + resp.statusText;\n    document.getElementById('status-' + id).className = 'status-badge status-' + Math.floor(resp.status/100) + 'xx';\n    document.getElementById('time-' + id).textContent = elapsed + 'ms';\n    try {\n      document.getElementById('respbody-' + id).textContent = JSON.stringify(JSON.parse(text), null, 2);\n    } catch(e) {\n      document.getElementById('respbody-' + id).textContent = text;\n    }\n  } catch(e) {\n    const elapsed = Math.round(performance.now() - start);\n    document.getElementById('status-' + id).textContent = 'Error';\n    document.getElementById('status-' + id).className = 'status-badge status-5xx';\n    document.getElementById('time-' + id).textContent = elapsed + 'ms';\n    document.getElementById('respbody-' + id).textContent = e.message + '\\n\\nNote: CORS may block requests from the browser. Try using a CORS proxy or test from the server side.';\n  }\n\n  btn.textContent = 'Send Request';\n  btn.disabled = false;\n}\n\n// === Helpers ===\nfunction esc(s) {\n  if(!s && s !== 0) return '';\n  const d = document.createElement('div');\n  d.textContent = String(s);\n  return d.innerHTML;\n}\n\nfunction slug(s) {\n  return s.replace(/[^a-zA-Z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');\n}\n\nfunction getExample(schema, seen) {\n  if(!schema) return null;\n  if(seen && seen.has(schema)) return null;\n  seen = seen || new Set();\n  seen.add(schema);\n  if(schema.example !== undefined) return schema.example;\n  if(schema.default !== undefined) return schema.default;\n  if(schema.$ref) {\n    const ref = resolveRef(schema.$ref);\n    if(ref) return getExample(ref, seen);\n  }\n  if(schema.allOf) {\n    let merged = {};\n    schema.allOf.forEach(s => { const ex = getExample(s, seen); if(ex && typeof ex === 'object') Object.assign(merged, ex); });\n    if(Object.keys(merged).length) return merged;\n  }\n  if(schema.oneOf && schema.oneOf.length) return getExample(schema.oneOf[0], seen);\n  if(schema.anyOf && schema.anyOf.length) return getExample(schema.anyOf[0], seen);\n  if(schema.type === 'object' && schema.properties) {\n    const obj = {};\n    Object.entries(schema.properties).forEach(([k, v]) => {\n      const ex = getExample(v, seen);\n      if(ex !== undefined) obj[k] = ex;\n    });\n    return obj;\n  }\n  if(schema.type === 'array') {\n    const item = getExample(schema.items, seen);\n    return item !== undefined ? [item] : [];\n  }\n  if(schema.type === 'string') return schema.enum ? schema.enum[0] : (schema.format === 'date-time' ? '2026-01-01T00:00:00Z' : 'string');\n  if(schema.type === 'integer' || schema.type === 'number') return schema.enum ? schema.enum[0] : 0;\n  if(schema.type === 'boolean') return true;\n  return null;\n}\n\nfunction resolveRef(ref) {\n  if(!spec || !ref.startsWith('#/')) return null;\n  const parts = ref.slice(2).split('/');\n  let obj = spec;\n  for(const p of parts) { obj = obj && 