{"type":"message","id":"f336d023","parentId":"1d47e9e5","timestamp":"2026-03-28T04:19:34.169Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_121a41562b824d83951d0901","name":"write","arguments":{"path":"/home/node/.openclaw/workspace/api-docs/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>API Documentation Generator</title>\n<style>\n:root {\n  --bg: #0f172a; --surface: #1e293b; --surface2: #334155;\n  --border: #475569; --text: #e2e8f0; --text-dim: #94a3b8;\n  --green: #22c55e; --blue: #3b82f6; --orange: #f59e0b; --red: #ef4444;\n  --purple: #a855f7; --pink: #ec4899; --cyan: #06b6d4;\n}\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }\n\n/* Layout */\n.app { display: flex; height: 100vh; }\n.sidebar { width: 300px; background: var(--surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; flex-shrink: 0; }\n.main { flex: 1; overflow-y: auto; padding: 32px; max-width: 960px; }\n\n/* Sidebar */\n.sidebar-header { padding: 20px; border-bottom: 1px solid var(--border); }\n.sidebar-header h1 { font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 8px; }\n.sidebar-header .badge { font-size: 10px; background: var(--blue); color: #fff; padding: 2px 6px; border-radius: 4px; }\n.info-card { padding: 12px 20px; border-bottom: 1px solid var(--border); }\n.info-card p { font-size: 13px; color: var(--text-dim); line-height: 1.5; }\n.nav { flex: 1; overflow-y: auto; padding: 12px 0; }\n.nav-group { margin-bottom: 8px; }\n.nav-group-title { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); padding: 8px 20px 4px; }\n.nav-item { display: flex; align-items: center; gap: 8px; padding: 6px 20px; cursor: pointer; font-size: 13px; color: var(--text-dim); transition: background 0.15s; text-decoration: none; }\n.nav-item:hover, .nav-item.active { background: var(--surface2); color: var(--text); }\n.nav-item .method { font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 3px; min-width: 48px; text-align: center; }\n.method-get { background: #22c55e22; color: var(--green); }\n.method-post { background: #3b82f622; color: var(--blue); }\n.method-put { background: #f59e0b22; color: var(--orange); }\n.method-patch { background: #a855f722; color: var(--purple); }\n.method-delete { background: #ef444422; color: var(--red); }\n.method-head { background: #06b6d422; color: var(--cyan); }\n.method-options { background: #94a3b822; color: var(--text-dim); }\n\n/* Main Content */\n.drop-zone { border: 2px dashed var(--border); border-radius: 12px; padding: 64px 32px; text-align: center; cursor: pointer; transition: border-color 0.2s; margin-bottom: 32px; }\n.drop-zone:hover, .drop-zone.dragover { border-color: var(--blue); }\n.drop-zone h2 { font-size: 22px; margin-bottom: 8px; }\n.drop-zone p { color: var(--text-dim); margin-bottom: 16px; }\n.drop-zone .or { color: var(--text-dim); font-size: 13px; }\n.btn { display: inline-block; padding: 10px 24px; border-radius: 8px; border: none; cursor: pointer; font-size: 14px; font-weight: 600; transition: opacity 0.15s; }\n.btn:hover { opacity: 0.85; }\n.btn-primary { background: var(--blue); color: #fff; }\n.btn-secondary { background: var(--surface2); color: var(--text); margin-left: 8px; }\n.btn-sm { padding: 6px 14px; font-size: 12px; border-radius: 6px; }\n\n/* Endpoint card */\n.endpoint { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; margin-bottom: 24px; overflow: hidden; }\n.endpoint-header { display: flex; align-items: center; gap: 12px; padding: 16px 20px; cursor: pointer; }\n.endpoint-header:hover { background: var(--surface2); }\n.endpoint-header .method { font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 4px; min-width: 60px; text-align: center; }\n.endpoint-header .path { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 14px; flex: 1; }\n.endpoint-header .summary { color: var(--text-dim); font-size: 13px; }\n.endpoint-header .arrow { color: var(--text-dim); transition: transform 0.2s; }\n.endpoint-header .arrow.open { transform: rotate(180deg); }\n\n.endpoint-body { padding: 0 20px 20px; }\n.endpoint-body.hidden { display: none; }\n.description { color: var(--text-dim); font-size: 13px; line-height: 1.6; margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--border); }\n.deprecated-badge { background: var(--orange); color: #000; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 4px; margin-left: 8px; }\n\n/* Try it */\n.try-section { background: var(--bg); border-radius: 8px; padding: 16px; margin-bottom: 16px; }\n.try-section h4 { font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-dim); margin-bottom: 10px; }\n.param-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }\n.param-row label { font-size: 13px; min-width: 120px; font-family: monospace; }\n.param-row label .required { color: var(--red); }\n.param-row input, .param-row select, .param-row textarea { background: var(--surface); border: 1px solid var(--border); color: var(--text); padding: 6px 10px; border-radius: 6px; font-size: 13px; flex: 1; min-width: 200px; }\n.param-row textarea { min-height: 80px; font-family: monospace; }\n.param-row .type { font-size: 11px; color: var(--text-dim); min-width: 60px; }\n.request-url { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 10px 14px; font-family: monospace; font-size: 13px; margin-bottom: 12px; word-break: break-all; display: flex; align-items: center; gap: 8px; }\n.request-url .method-label { font-weight: 700; white-space: nowrap; }\n.send-btn { margin-top: 8px; }\n.response-section { margin-top: 16px; }\n.response-header { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }\n.status-badge { font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 4px; }\n.status-2xx { background: #22c55e22; color: var(--green); }\n.status-3xx { background: #3b82f622; color: var(--blue); }\n.status-4xx { background: #f59e0b22; color: var(--orange); }\n.status-5xx { background: #ef444422; color: var(--red); }\n.response-time { font-size: 12px; color: var(--text-dim); }\n.response-body { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 14px; font-family: monospace; font-size: 13px; white-space: pre-wrap; word-break: break-all; max-height: 400px; overflow-y: auto; }\n\n/* Schema / Params table */\n.params-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 13px; }\n.params-table th { text-align: left; padding: 8px 12px; background: var(--surface2); border-bottom: 1px solid var(--border); font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-dim); }\n.params-table td { padding: 8px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }\n.params-table .nested { padding-left: 24px; background: var(--bg); }\n.params-table .name { font-family: monospace; }\n.params-table .type { color: var(--cyan); font-size: 12px; }\n.params-table .required-mark { color: var(--red); font-size: 11px; }\n.params-table .desc { color: var(--text-dim); max-width: 300px; }\n\n/* Response examples */\n.response-examples { margin-top: 16px; }\n.example-tabs { display: flex; gap: 4px; margin-bottom: 8px; }\n.example-tab { padding: 4px 12px; border-radius: 6px; font-size: 12px; cursor: pointer; background: var(--surface2); color: var(--text-dim); border: none; }\n.example-tab.active { background: var(--blue); color: #fff; }\n.example-content { display: none; }\n.example-content.active { display: block; }\n.code-block { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 14px; font-family: monospace; font-size: 12px; white-space: pre-wrap; word-break: break-all; max-height: 300px; overflow-y: auto; }\n\n/* Servers */\n.servers-bar { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 10px 16px; margin-bottom: 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; flex-wrap: wrap; }\n.servers-bar label { color: var(--text-dim); font-size: 12px; }\n.servers-bar select { background: var(--bg); border: 1px solid var(--border); color: var(--text); padding: 4px 8px; border-radius: 4px; font-size: 13px; }\n\n/* Security */\n.auth-section { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 10px 16px; margin-bottom: 24px; display: flex; align-items: center; gap: 8px; font-size: 13px; flex-wrap: wrap; }\n.auth-section label { color: var(--text-dim); font-size: 12px; }\n.auth-section input { background: var(--bg); border: 1px solid var(--border); color: var(--text); padding: 4px 8px; border-radius: 4px; font-size: 13px; }\n\n/* Scrollbar */\n::-webkit-scrollbar { width: 6px; }\n::-webkit-scrollbar-track { background: transparent; }\n::-webkit-scrollbar-thumb { background: var(--surface2); border-radius: 3px; }\n\n/* Responsive */\n@media (max-width: 768px) {\n  .app { flex-direction: column; height: auto; }\n  .sidebar { width: 100%; height: auto; max-height: 40vh; }\n  .main { padding: 16px; }\n}\n\n/* Spinner */\n.spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid var(--text-dim); border-top-color: var(--blue); border-radius: 50%; animation: spin 0.6s linear infinite; }\n@keyframes spin { to { transform: rotate(360deg); } }\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <aside class=\"sidebar\" id=\"sidebar\">\n    <div class=\"sidebar-header\">\n      <h1>📖 API Docs <span class=\"badge\" id=\"version-badge\"></span></h1>\n    </div>\n    <div class=\"info-card\" id=\"api-info\" style=\"display:none\"></div>\n    <nav class=\"nav\" id=\"nav\"></nav>\n  </aside>\n  <main class=\"main\" id=\"main\">\n    <div class=\"drop-zone\" id=\"drop-zone\">\n      <h2>📄 Load OpenAPI / Swagger Spec</h2>\n      <p>Drop a JSON or YAML file here, or paste a URL</p>\n      <button class=\"btn btn-primary\" onclick=\"document.getElementById('file-input').click()\">Choose File</button>\n      <span class=\"or\">or</span>\n      <button class=\"btn btn-secondary\" id=\"load-demo-btn\">Load Demo Spec</button>\n      <input type=\"file\" id=\"file-input\" accept=\".json,.yaml,.yml\" style=\"display:none\">\n      <div style=\"margin-top:16px; display:flex; gap:8px; justify-content:center; align-items:center;\">\n        <input type=\"text\" id=\"url-input\" placeholder=\"https://api.example.com/openapi.json\" style=\"background:var(--surface);border:1px solid var(--border);color:var(--text);padding:8px 12px;border-radius:6px;font-size:13px;width:300px\">\n        <button class=\"btn btn-primary btn-sm\" id=\"load-url-btn\">Load URL</button>\n      </div>\n    </div>\n    <div id=\"servers-bar\" class=\"servers-bar\" style=\"display:none\">\n      <label>Base URL:</label>\n      <select id=\"server-select\"></select>\n      <input type=\"text\" id=\"server-custom\" placeholder=\"Custom base URL\" style=\"background:var(--bg);border:1px solid var(--border);color:var(--text);padding:4px 8px;border-radius:4px;font-size:13px;flex:1;min-width:200px;display:none\">\n    </div>\n    <div id=\"auth-section\" class=\"auth-section\" style=\"display:none\">\n      <label>🔑 Authorization:</label>\n      <select id=\"auth-type\" style=\"background:var(--bg);border:1px solid var(--border);color:var(--text);padding:4px 8px;border-radius:4px;font-size:13px\"></select>\n      <input type=\"text\" id=\"auth-token\" placeholder=\"Bearer token or API key\" style=\"flex:1;min-width:200px\">\n    </div>\n    <div id=\"content\"></div>\n  </main>\n</div>\n\n<script>\nlet spec = null;\nlet authValues = {};\n\n// === YAML polyfill (simple) ===\nfunction parseYAML(text) {\n  try { return jsyaml.load(text); } catch(e) { return null; }\n}\n\n// === Load jsyaml if needed ===\n(function loadYAML() {\n  if (typeof jsyaml !== 'undefined') return;\n  const s = document.createElement('script');\n  s.src = 'https://cdn.jsdelivr.net/npm/js-yaml@4/dist/js-yaml.min.js';\n  s.onload = () => console.log('js-yaml loaded');\n  document.head.appendChild(s);\n})();\n\n// === File / URL / Drag-Drop ===\nconst dropZone = document.getElementById('drop-zone');\nconst fileInput = document.getElementById('file-input');\nconst urlInput = document.getElementById('url-input');\n\ndropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });\ndropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));\ndropZone.addEventListener('drop', e => { e.preventDefault(); dropZone.classList.remove('dragover'); if(e.dataTransfer.files[0]) readFile(e.dataTransfer.files[0]); });\nfileInput.addEventListener('change', () => { if(fileInput.files[0]) readFile(fileInput.files[0]); });\ndocument.getElementById('load-url-btn').addEventListener('click', () => {\n  const url = urlInput.value.trim();\n  if(!url) return;\n  fetch(url).then(r => r.text()).then(text => {\n    let data = JSON.parse(text);\n    if(!data) data = parseYAML(text);\n    if(data) loadSpec(data); else alert('Failed to parse spec');\n  }).catch(e => alert('Failed to fetch: ' + e.message));\n});\n\nfunction readFile(file) {\n  const reader = new FileReader();\n  reader.onload = () => {\n    const text = reader.result;\n    try {\n      let data = JSON.parse(text);\n      loadSpec(data);\n    } catch(e) {\n      const data = parseYAML(text);\n      if(data) loadSpec(data); else alert('Failed to parse file');\n    }\n  };\n  reader.readAsText(file);\n}\n\n// === Demo spec ===\ndocument.getElementById('load-demo-btn').addEventListener('click', () => loadSpec({\n  openapi: '3.0.3',\n  info: { title: 'Petstore API', version: '1.0.0', description: 'A sample Pet Store Server based on the OpenAPI 3.0 specification.' },\n  servers: [{ url: 'https://petstore.example.com/v1', description: 'Production' }, { url: 'https://petstore-staging.example.com/v1', description: 'Staging' }],\n  components: {\n    schemas: {\n      Pet: { type: 'object', required: ['id','name'], properties: { id: { type: 'integer', format: 'int64', example: 1 }, name: { type: 'string', example: 'Buddy' }, tag: { type: 'string', example: 'dog' }, status: { type: 'string', enum: ['available','pending','sold'], example: 'available' } } },\n      Pets: { type: 'array', items: { $ref: '#/components/schemas/Pet' } },\n      Error: { type: 'object', required: ['code','message'], properties: { code: { type: 'integer', format: 'int32', example: 400 }, message: { type: 'string', example: 'Invalid request' } } }\n    }\n  },\n  paths: {\n    '/pets': {\n      get: { summary: 'List all pets', operationId: 'listPets', tags: ['pets'], parameters: [{ name: 'limit', in: 'query', description: 'How many items to return', required: false, schema: { type: 'integer', format: 'int32', default: 20 } }], responses: { '200': { description: 'A paged array of pets', content: { 'application/json': { schema: { $ref: '#/components/schemas/Pets' }, example: [{ id: 1, name: 'Buddy', tag: 'dog', status: 'available' }, { id: 2, name: 'Whiskers', tag: 'cat', status: 'pending' }] } } } },\n      post: { summary: 'Create a pet', operationId: 'createPet', tags: ['pets'], requestBody: { required: true, content: { 'application/json': { schema: { $ref: '#/components/schemas/Pet' }, example: { id: 10, name: 'NewPet', tag: 'hamster', status: 'available' } } } }, responses: { '201': { description: 'Null response', content: { 'application/json': { schema: { $ref: '#/components/schemas/Pet' } } } }, '400': { description: 'Unexpected error', content: { 'application/json': { schema: { $ref: '#/components/schemas/Error' }, example: { code: 400, message: 'Name is required' } } } } } }\n    },\n    '/pets/{petId}': {\n      get: { summary: 'Info for a specific pet', operationId: 'showPetById', tags: ['pets'], parameters: [{ name: 'petId', in: 'path', description: 'The id of the pet', required: true, schema: { type: 'integer', format: 'int64' } }], responses: { '200': { description: 'Expected response', content: { 'application/json': { schema: { $ref: '#/components/schemas/Pet' }, example: { id: 1, name: 'Buddy', tag: 'dog', status: 'available' } } } }, '404': { description: 'Pet not found', content: { 'application/json': { schema: { $ref: '#/components/schemas/Error' }, example: { code: 404, message: 'Pet not found' } } } } }\n    },\n    '/pets/{petId}': {\n      delete: { summary: 'Delete a pet', operationId: 'deletePet', tags: ['pets'], parameters: [{ name: 'petId', in: 'path', required: true, schema: { type: 'integer' } }], responses: { '204': { description: 'Pet deleted' }, '404': { description: 'Pet not found', content: { 'application/json': { schema: { $ref: '#/components/schemas/Error' } } } } }\n    }\n  }\n}));\n\n// === Main loader ===\nfunction loadSpec(data) {\n  spec = data;\n  const isSwagger = !!data.swagger;\n  const version = isSwagger ? data.swagger : data.openapi;\n  document.getElementById('version-badge').textContent = isSwagger ? 'Swagger' : 'OpenAPI ' + version;\n  \n  // Info\n  const info = data.info || {};\n  document.getElementById('api-info').style.display = 'block';\n  document.getElementById('api-info').innerHTML = `<p>${info.description || info.title || 'API'}</p>`;\n  document.title = (info.title || 'API') + ' — Docs';\n\n  // Servers\n  const servers = data.servers || (data.host ? [{ url: (data.schemes ? data.schemes[0] : 'https') + '://' + data.host + (data.basePath || '') }] : [{ url: '' }]);\n  const sb = document.getElementById('servers-bar');\n  const sel = document.getElementById('server-select');\n  sel.innerHTML = '';\n  servers.forEach((s, i) => {\n    const opt = document.createElement('option');\n    opt.value = s.url; opt.textContent = s.description || s.url;\n    sel.appendChild(opt);\n  });\n  if(servers.length > 0) { const opt = document.createElement('option'); opt.value = '__custom__'; opt.textContent = 'Custom...'; sel.appendChild(opt); }\n  sel.onchange = () => {\n    document.getElementById('server-custom').style.display = sel.value === '__custom__' ? 'inline-block' : 'none';\n  };\n  sb.style.display = 'flex';\n\n  // Auth\n  const securityDefs = (data.components && data.components.securitySchemes) || data.securityDefinitions || {};\n  const authSec = document.getElementById('auth-section');\n  const authType = document.getElementById('auth-type');\n  const keys = Object.keys(securityDefs);\n  if(keys.length > 0) {\n    authSec.style.display = 'flex';\n    authType.innerHTML = '<option value=\"none\">None</option>';\n    keys.forEach(k => { const o = document.createElement('option'); o.value = k; o.textContent = k; authType.appendChild(o); });\n    authSec.style.display = 'flex';\n  } else {\n    authSec.style.display = 'none';\n  }\n\n  dropZone.style.display = 'none';\n  renderNav();\n  renderEndpoints();\n}\n\nfunction getBaseUrl() {\n  const sel = document.getElementById('server-select');\n  return sel.value === '__custom__' ? document.getElementById('server-custom').value.trim() : sel.value;\n}\n\nfunction getAuthHeaders() {\n  const type = document.getElementById('auth-type').value;\n  if(!type || type === 'none') return {};\n  const token = document.getElementById('auth-token').value.trim();\n  if(!token) return {};\n  const def = (spec.components && spec.components.securitySchemes && spec.components.securitySchemes[type]) || (spec.securityDefinitions && spec.securityDefinitions[type]);\n  if(!def) return { Authorization: 'Bearer ' + token };\n  if(def.type === 'http' && def.scheme === 'bearer') return { Authorization: 