ethod);\n      html += `<a class=\"nav-item\" href=\"#${id}\"><span class=\"method method-${method}\">${method.toUpperCase()}</span><span>${esc(path)}</span></a>`;\n    });\n  });\n  \n  nav.innerHTML = html;\n}\n\n// === Render endpoints ===\nfunction renderEndpoints() {\n  const content = document.getElementById('content');\n  const paths = spec.paths || {};\n  let html = '';\n  \n  // Group by tag, preserving order\n  const groups = new Map();\n  const order = [];\n  Object.entries(paths).forEach(([path, methods]) => {\n    Object.entries(methods).forEach(([method, op]) => {\n      if(!['get','post','put','patch','delete','head','options'].includes(method)) return;\n      const tag = (op.tags && op.tags[0]) || 'default';\n      if(!groups.has(tag)) { groups.set(tag, []); order.push(tag); }\n      groups.get(tag).push({ path, method, op });\n    });\n  });\n\n  order.forEach(tag => {\n    html += `<h2 style=\"font-size:20px;margin:32px 0 16px;padding-bottom:8px;border-bottom:1px solid var(--border)\">${esc(tag)}</h2>`;\n    groups.get(tag).forEach(({ path, method, op }) => {\n      html += renderEndpoint(path, method, op);\n    });\n  });\n\n  content.innerHTML = html;\n\n  // Bind toggle\n  content.querySelectorAll('.endpoint-header').forEach(hdr => {\n    hdr.addEventListener('click', () => {\n      const body = hdr.nextElementSibling;\n      const arrow = hdr.querySelector('.arrow');\n      body.classList.toggle('hidden');\n      arrow.classList.toggle('open');\n    });\n  });\n\n  // Bind send\n  content.querySelectorAll('.send-btn').forEach(btn => {\n    btn.addEventListener('click', () => sendRequest(btn));\n  });\n}\n\nfunction renderEndpoint(path, method, op) {\n  const id = slug(path + '-' + method);\n  const deprecated = op.deprecated ? '<span class=\"deprecated-badge\">DEPRECATED</span>' : '';\n  \n  let html = `<div class=\"endpoint\" id=\"${id}\">\n    <div class=\"endpoint-header\">\n      <span class=\"method method-${method}\">${method.toUpperCase(