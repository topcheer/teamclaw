# TeamClaw custom OpenClaw image
# Based on official ghcr.io/openclaw/openclaw, pinned by digest (#225 C1).
# Adds the teamclaw extension and its runtime dependencies.
#
# Build: docker build -f Dockerfile.teamclaw -t registry.iot2.win/openclaw:teamclaw-test .
# Push:  docker push registry.iot2.win/openclaw:teamclaw-test
#
# Multi-arch: docker buildx build --platform linux/amd64 -f Dockerfile.teamclaw \
#             -t registry.iot2.win/openclaw:teamclaw-test --push .

# Base image pinned by digest for reproducible releases (#225 C1).
# Anchors: upstream 2026.10.10 at the official-image-base switch; digest
# resolved from ghcr.io/openclaw/openclaw:latest (= upstream 2026.11.2) on
# 2026-11-09; multi-arch index: linux/amd64 + linux/arm64.
# Re-pin deliberately on upstream bumps:
#   docker buildx imagetools inspect ghcr.io/openclaw/openclaw:latest
ARG BASE_IMAGE=ghcr.io/openclaw/openclaw@sha256:55294524dac01370288fb4beb16714b60f75cec0e96e07e662054cf29900965a

FROM ${BASE_IMAGE}

# OCI image metadata (also the image-store description)
LABEL org.opencontainers.image.title="teamclaw-openclaw" \
      org.opencontainers.image.description="TeamClaw runtime on OpenClaw: virtual software team (controller + role workers) with a Web UI, internet tunnel sharing (managed / self-hosted Cloudflare / anonymous trycloudflare) and teamauto GitHub automation." \
      org.opencontainers.image.source="https://github.com/topcheer/teamclaw"

USER root

# Install teamclaw runtime dependencies without disrupting existing node_modules.
RUN mkdir -p /tmp/deps && cd /tmp/deps && \
    npm init -y --silent 2>/dev/null && \
    npm install --save @sinclair/typebox@0.34.48 bonjour-service@1.3.0 2>/dev/null && \
    find node_modules -mindepth 1 -maxdepth 1 -type d | while read pkg; do \
      pkg="${pkg#node_modules/}"; \
      if [ ! -d "/app/node_modules/$pkg" ]; then \
        mkdir -p "$(dirname /app/node_modules/$pkg)" && \
        cp -r "node_modules/$pkg" "/app/node_modules/$pkg"; \
      fi; \
    done && \
    rm -rf /tmp/deps

USER node

# Copy teamclaw extension source for jiti runtime compilation.
COPY src/package.json /app/extensions/teamclaw/package.json
COPY src/openclaw.plugin.json /app/extensions/teamclaw/openclaw.plugin.json
COPY src/api.ts /app/extensions/teamclaw/api.ts
COPY src/index.ts /app/extensions/teamclaw/index.ts
COPY src/cli.mjs /app/extensions/teamclaw/cli.mjs
COPY src/tsconfig.json /app/extensions/teamclaw/tsconfig.json
COPY src/src/ /app/extensions/teamclaw/src/
COPY src/README.md /app/extensions/teamclaw/README.md
# Plugin skills (worker skill discovery expects extensions/teamclaw/skills)
COPY src/skills/ /app/extensions/teamclaw/skills/

# Note: the legacy baked-in patch was removed - the plugin's
# resolveBakedTeamClawPluginRootDir() (PR #86) probes the image layout
# (/app/extensions/teamclaw via process.argv[1]) natively.
